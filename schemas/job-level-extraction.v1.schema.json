{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawcv.local/schemas/job-level-extraction.v1.schema.json",
  "title": "JD Job Level Extraction Output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "job-level-extraction.v1"
    },
    "targetLevel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "required": ["schemaVersion", "targetLevel", "confidence", "evidence"]
}
