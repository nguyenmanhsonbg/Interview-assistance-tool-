{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawcv.local/schemas/answer_evaluation.v1.json",
  "title": "Answer Evaluation Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "perAnswerEvaluations",
    "competencyEvaluations",
    "strengths",
    "gaps",
    "conflicts",
    "risks",
    "recommendedLiveQuestions",
    "interviewBrief",
    "confidence",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "answer-evaluation.v1" },
    "operation": { "const": "ANSWER_EVALUATION" },
    "perAnswerEvaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["answerId", "questionId", "score", "evidenceStatus", "reasoning", "evidenceFound", "concerns", "cvConsistency"],
        "properties": {
          "answerId": { "type": "string", "minLength": 1 },
          "questionId": { "type": "string", "minLength": 1 },
          "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
          "evidenceStatus": {
            "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONFLICTING", "NOT_MET", "NOT_ASSESSED"]
          },
          "reasoning": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "evidenceFound": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 },
          "concerns": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 },
          "cvConsistency": { "enum": ["CONSISTENT", "PARTIALLY_CONSISTENT", "CONFLICTING", "NOT_ASSESSED"] }
        }
      }
    },
    "competencyEvaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competencyKey", "summary", "evidenceStatus", "confidence"],
        "properties": {
          "competencyKey": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "evidenceStatus": {
            "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONFLICTING", "NOT_MET", "NOT_ASSESSED"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "strengths": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
    "gaps": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
    "conflicts": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
    "risks": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
    "recommendedLiveQuestions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "text", "targetCompetency", "reason", "evidenceToSeek", "isRequired", "priority"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "targetCompetency": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidenceToSeek": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "isRequired": { "type": "boolean" },
          "priority": { "enum": ["REQUIRED", "HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "interviewBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "completion",
        "strengths",
        "gaps",
        "conflicts",
        "competencyMatrix",
        "requiredLiveQuestions",
        "additionalLiveQuestions",
        "answerSignals",
        "confidence",
        "limitations"
      ],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answeredCount", "totalCount", "durationSeconds"],
          "properties": {
            "answeredCount": { "type": "integer", "minimum": 0 },
            "totalCount": { "type": "integer", "minimum": 1, "maximum": 8 },
            "durationSeconds": { "type": "integer", "minimum": 0 }
          }
        },
        "strengths": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
        "gaps": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
        "conflicts": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
        "competencyMatrix": { "type": "array", "items": { "type": "object" }, "maxItems": 50 },
        "requiredLiveQuestions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 3000 } },
        "additionalLiveQuestions": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 3000 } },
        "answerSignals": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 30 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "limitations": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "limitations": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 }
  }
}
