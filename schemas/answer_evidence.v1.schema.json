{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawcv.local/schemas/answer_evidence.v1.json",
  "title": "Answer Evidence Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "perAnswerEvidence", "competencyEvidence", "confidence", "limitations"],
  "properties": {
    "schemaVersion": { "const": "answer-evidence.v1" },
    "operation": { "const": "ANSWER_EVIDENCE_ANALYSIS" },
    "perAnswerEvidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["answerId", "questionId", "score", "evidenceStatus", "reasoning", "evidenceFound", "concerns", "cvConsistency"],
        "properties": {
          "answerId": { "type": "string", "minLength": 1 },
          "questionId": { "type": "string", "minLength": 1 },
          "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
          "evidenceStatus": { "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONFLICTING", "NOT_MET", "NOT_ASSESSED"] },
          "reasoning": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "evidenceFound": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 },
          "concerns": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 },
          "cvConsistency": { "enum": ["CONSISTENT", "PARTIALLY_CONSISTENT", "CONFLICTING", "NOT_ASSESSED"] }
        }
      }
    },
    "competencyEvidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["competencyKey", "evidenceSummary", "evidenceStatus", "confidence"],
        "properties": {
          "competencyKey": { "type": "string", "minLength": 1 },
          "evidenceSummary": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "evidenceStatus": { "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONFLICTING", "NOT_MET", "NOT_ASSESSED"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "limitations": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 }
  }
}
