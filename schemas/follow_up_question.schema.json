{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawcv.local/schemas/follow_up_question.v1.json",
  "title": "Follow-up Question Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "questions", "stopCondition", "confidence", "limitations"],
  "properties": {
    "schemaVersion": { "const": "follow-up.v1" },
    "operation": { "const": "FOLLOW_UP" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "text", "targetCompetency", "reason", "evidenceToSeek", "stopCondition", "priority"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "text": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "targetCompetency": { "type": "string", "minLength": 1, "maxLength": 100 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidenceToSeek": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "stopCondition": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "priority": { "enum": ["REQUIRED", "HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "stopCondition": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "limitations": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 20 }
  }
}
